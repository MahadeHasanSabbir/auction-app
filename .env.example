APP_NAME=Auction-App
APP_ENV=local
APP_KEY=
# true shows full error details in the browser: local development only.
# Production must use false (it is forced off there anyway).
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Marketplace
AUCTION_CURRENCY=BDT
AUCTION_CURRENCY_DECIMALS=2
# System owner created by `php artisan db:seed`. Outside production the
# password defaults to "admin"; production seeding requires it to be set.
AUCTION_OWNER_NAME="System Owner"
AUCTION_OWNER_EMAIL=admin@auction.com
AUCTION_OWNER_PASSWORD=
# Payment gateways offered to payers (fake, sslcommerz, stripe). The fake one
# pays at once and is refused in production.
PAYMENT_GATEWAYS=fake
# SSLCommerz: the IPN URL is {APP_URL}/payments/sslcommerz/notify.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Stripe: point a webhook at {APP_URL}/payments/stripe/notify for the
# checkout.session.* events and paste its signing secret here.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Google sign-in for buyers (the button is hidden while these are empty).
# Authorised redirect URI: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# New buyers and companies must be verified before bidding, listing or withdrawing.
AUCTION_KYC_REQUIRED=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=auction
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Live updates are queued here; `composer dev` runs a worker for it (queue:work --queue=broadcasts).
BROADCAST_QUEUE=broadcasts

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Websockets. Local development uses Laravel Reverb (php artisan reverb:start).
# Replace these credentials outside local development.
# To use a hosted service instead, set BROADCAST_CONNECTION=pusher and fill PUSHER_*.
REVERB_APP_ID=100001
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Web push (the installed app). Generate with: php artisan webpush:vapid
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# API
API_RATE_PER_MINUTE=120
API_GUEST_RATE_PER_MINUTE=60
